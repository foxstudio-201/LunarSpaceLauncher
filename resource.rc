#include <windows.h>

1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XyoLauncher"
            VALUE "FileDescription", "XyoLauncher+"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "XyoLauncher+"
            VALUE "OriginalFilename", "XyoLauncher+.exe"
            VALUE "ProductName", "XyoLauncher+"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
